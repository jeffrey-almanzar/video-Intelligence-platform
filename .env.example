# Copy to .env and adjust. Values here are LOCAL DEVELOPMENT defaults only.
# Never put real credentials in this file.

# --- General
NODE_ENV=development
LOG_LEVEL=info
# Human-readable API logs for native runs (the API container always logs JSON).
LOG_PRETTY=true

# --- PostgreSQL (docker compose)
POSTGRES_USER=vip
POSTGRES_PASSWORD=vip_local_dev
POSTGRES_DB=vip
POSTGRES_PORT=5432
# Schema owner: used only by migrations (`make migrate`).
MIGRATION_DATABASE_URL=postgres://vip:vip_local_dev@localhost:5432/vip
# Per-service login users with least privilege (ADR-003). `make migrate` creates them
# from these URLs (user + password) and attaches them to their group roles.
API_DATABASE_URL=postgres://vip_api:vip_api_local_dev@localhost:5432/vip
AI_DATABASE_URL=postgres://vip_ai:vip_ai_local_dev@localhost:5432/vip
# The same API login as seen from inside Docker (host `postgres`).
API_DATABASE_URL_DOCKER=postgres://vip_api:vip_api_local_dev@postgres:5432/vip

# --- Redis (docker compose)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Object storage (S3 API; SeaweedFS locally, AWS S3 in the cloud)
S3_PORT=8333
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=vip-media
S3_ACCESS_KEY_ID=vip_local_access
S3_SECRET_ACCESS_KEY=vip_local_secret_change_me
S3_FORCE_PATH_STYLE=true

# --- NestJS API
API_PORT=3000
# Browser origins allowed to call the API and to PUT upload parts to storage (4100: E2E tests).
CORS_ALLOWED_ORIGINS=http://localhost:4000,http://localhost:4100
MAX_UPLOAD_BYTES=10737418240
# --- Auth (ADR-017). Generate the secret with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Secure cookies need HTTPS; always on in production. Leave false for http://localhost.
COOKIE_SECURE=false
AUTH_RATE_LIMIT_PER_MINUTE=10
# Local development: a seeded account (dev@vip.local) that owns videos uploaded before Phase 5.
# DEV_USER_PASSWORD lets it sign in; both are ignored in production.
SEED_DEV_USER=true
DEV_USER_ID=00000000-0000-7000-8000-000000000001
DEV_USER_PASSWORD=change-me-dev-password

# --- Python AI service (runs natively on the host for Metal access)
AI_API_PORT=8000
AI_API_URL=http://localhost:8000
# Shared secret for internal service-to-service calls (NestJS -> ai-api).
AI_SERVICE_TOKEN=local-dev-service-token-change-me

# --- Pipeline limits (Python worker)
MAX_DURATION_SECONDS=14400
MAX_KEYFRAMES_PER_HOUR=120
# Local scratch space for media being processed (cleaned by `finalize`).
WORK_DIR=.data/work

# --- Transcription (ADR-023). auto = MLX on Apple Silicon, faster-whisper elsewhere.
TRANSCRIPTION_PROVIDER=auto
# Empty = provider default (large-v3-turbo). e.g. mlx-community/whisper-large-v3-turbo, tiny
WHISPER_MODEL=
# Empty = detect from the first window. e.g. en, es
TRANSCRIPTION_LANGUAGE=
TRANSCRIPTION_WINDOW_S=600

# --- Local inference
OLLAMA_BASE_URL=http://localhost:11434

# --- Analysis (ADR-024). Map runs per ~10-minute chunk; reduce merges, titles and summarizes.
ANALYSIS_MAP_MODEL=qwen3:4b
ANALYSIS_REDUCE_MODEL=qwen3:8b
EMBEDDING_MODEL=qwen3-embedding:0.6b
ANALYSIS_NUM_CTX=8192
ANALYSIS_CHUNK_TOKENS=2000
LLM_KEEP_ALIVE=10m
# Q&A: hybrid (dense + full-text, ADR-026) or baseline (Phase 5 full-text only)
QA_STRATEGY=hybrid
# ollama | replay (recorded responses from LLM_REPLAY_FIXTURE; tests and demos, never production)
LLM_BACKEND=ollama
LLM_REPLAY_FIXTURE=

# --- OpenTelemetry. Empty = disabled. `make obs` starts a local collector on :4318.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Same collector as seen from inside Docker containers.
OTEL_EXPORTER_OTLP_ENDPOINT_DOCKER=
